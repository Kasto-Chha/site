# Copy to .env.local or set env vars in your shell before running the scripts

# Canonical public site URL (NO trailing slash). Powers social-share links, the
# Open Graph image/canonical URLs (metadataBase), robots.txt and sitemap.xml.
# MUST be your production domain in prod — if it's unset or a preview URL, social
# previews break. e.g. https://kastochha.com
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# IndexNow: pushes new and changed urls to Bing and Yandex instead of waiting
# to be crawled. Must be hex (the rewrite in next.config.js only matches hex,
# so that /robots.txt cannot be captured by it). Generate one with:
#   openssl rand -hex 16
# Leave unset to disable — pings are skipped and nothing breaks.
INDEXNOW_KEY=

# Required by the app and API seeder:
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=public-anon-key

# Service role key (server-only). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=service_role_...

# Gemini (Google Generative Language) — powers the AI chat at /chat and the
# Experience review auto-classification (server-only).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash

# Live search: the chat grounds answers with Google Search, so prices, launch
# dates and news come from today's web instead of the model's training data.
# The model decides per question whether a search is needed. Grounded requests
# are billed differently from plain ones — set to "off" to disable.
CHAT_LIVE_SEARCH=on

# Clerk auth keys (required for sign-in and posting).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Upstash Redis (optional) — powers the burst rate limiting on chat/votes/posts.
# Without these, the sliding-window limiter is skipped (the app still works, and
# the chat quota below still applies). Create a free database at
# https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# AI chat quota per signed-in account, counted from stored messages so it holds
# with or without Upstash. Admins are exempt. Defaults shown; raise or lower
# without a code change.
CHAT_DAILY_LIMIT=50
# Fallback per-minute burst ceiling, used only when Upstash isn't configured.
CHAT_BURST_LIMIT=10

# Direct Postgres connection string for running DB migrations (db:migrate).
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
